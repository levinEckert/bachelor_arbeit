@article{antoniUnsupervisedNoiseCancellation2004,
  title = {Unsupervised Noise Cancellation for Vibration Signals: Part {{II}}—a Novel Frequency-Domain Algorithm},
  shorttitle = {Unsupervised Noise Cancellation for Vibration Signals},
  author = {Antoni, J. and Randall, R.B.},
